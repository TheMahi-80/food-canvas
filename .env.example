# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project (Dashboard -> Project Settings -> API). Used from Stage 2 onward.
# The anon/publishable key is safe in the browser; all access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Fallback WhatsApp ordering number (digits only, 880...). The admin settings value takes priority.
FOOD_CANVAS_WHATSAPP_NUMBER=8801845690533

# Public site URL, used for metadata / Open Graph. Example: https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Do NOT add the Supabase service-role key here; the app does not use it.
